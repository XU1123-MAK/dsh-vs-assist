{
  "name": "dsh-vs-assist",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that drives Visual Studio through its DTE COM automation: read the editor context, insert or replace code in VS, build, read errors, and run.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skill",
    "cordis.patch.yml",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "visual-studio",
    "dte",
    "msbuild",
    "code-assistant"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
